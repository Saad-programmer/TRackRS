# Compatibility entry point. CMake owns the version, flags and dependency discovery.
TRACKRS_NATIVE ?= OFF
TRACKRS_LTO ?= ON
BUILD_DIR ?= ../build/win-mingw-release
.PHONY: all clean test install package
all:
	cmake -S .. -B $(BUILD_DIR) -G Ninja -DCMAKE_BUILD_TYPE=Release -DTRACKRS_NATIVE=$(TRACKRS_NATIVE) -DTRACKRS_LTO=$(TRACKRS_LTO)
	cmake --build $(BUILD_DIR)
test: all
	ctest --test-dir $(BUILD_DIR) --output-on-failure
install: all
	cmake --install $(BUILD_DIR)
package: test
	cpack --config $(BUILD_DIR)/CPackConfig.cmake
clean:
	cmake --build $(BUILD_DIR) --target clean
