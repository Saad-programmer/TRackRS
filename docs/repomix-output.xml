void Gui::measureWidgetTree(int w)
{
  widget[w].childcount = 0;
  widget[w].fillercount = 0;

  switch (widget[w].type) {
  default:

    widget[w].dims_measure = widget[w].dims_min;

    break;

  case GWT_CONTAINER: {

    vec2f measure = vec2f(0.0f, 0.0f);

    for (unsigned int i = 0; i < widget.size(); i++) {
