PEffect *PSSEffect::loadEffect(const std::string &name)
{
  PEffect *fx = fxlist.find(name);
  if (!fx) {
    try
    {
      fx = new PEffect (name);
    }
    catch (PException &e)
    {
      if (PUtil::isDebugLevel(DEBUGLEVEL_ENDUSER))
        PUtil::outLog() << "Failed to load " << name << ": " << e.what () << std::endl;
      return nullptr;
    }
    fx->setFirstValidTechnique();
    fxlist.add(fx);
  }
  return fx;
}

