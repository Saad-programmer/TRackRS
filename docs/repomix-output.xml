        cfg.getCtrl().map[i].type = PConfig::UserControl::TypeUnassigned;
      break;

    case PConfig::UserControl::TypeJoyAxis:
      if (0 >= getNumJoysticks() || cfg.getCtrl().map[i].joyaxis.axis >= getJoyNumAxes(0))
        cfg.getCtrl().map[i].type = PConfig::UserControl::TypeUnassigned;
      break;
    }
  }
