        glPopMatrix(); // 2
    }
    #endif
    {
        tex_fontSourceCodeOutlined->bind();

        glColor4f(1.0f, 0.0f, 0.0f, 1.0f);
        glPushMatrix(); // 2
        glTranslatef(0.0f, 0.2f, 0.0f);
        glScalef(0.6f, 0.6f, 1.0f);
