*/
  }

  static quat<T> identity () { return quat<T>(0,0,0,1); }

  static quat<T> rand() {
    quat<T> ret;
    float lengthsq;
    do { ret=quat<T>((T)2 * (T)::rand() / (T)RAND_MAX - (T)1,
            (T)2 * (T)::rand() / (T)RAND_MAX - (T)1,
            (T)2 * (T)::rand() / (T)RAND_MAX - (T)1,
            (T)2 * (T)::rand() / (T)RAND_MAX - (T)1);
      lengthsq = ret.x*ret.x + ret.y*ret.y + ret.z*ret.z + ret.w*ret.w;
