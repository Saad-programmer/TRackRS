void MainApp::levelScreenAction(int action, int index)
{
  appstate = AS_LEVEL_SCREEN;

  // Play click sound
  if (action != AA_INIT && aud_shiftdown && cfg.getEnableSound()) {
    audinst.push_back(new PAudioInstance(aud_shiftdown));
    audinst.back()->play();
  }

  switch (action) {
  case AA_INIT:
    lss.state = AM_TOP;
    break;
  case AA_RESUME:
    // lss.state should be AM_TOP_EVT_PREP, continuing event
    break;
  case AA_RELOAD_ALL:
    reloadAll();
    cfg.storeConfig();
    lss.state = AM_TOP;
    break;
  case AA_GO_TOP:
    lss.state = AM_TOP;
    break;
  case AA_GO_EVT:
    if (lss.state == AM_TOP_EVT_PREP &&
