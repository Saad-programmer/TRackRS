std::string MainApp::getVehicleUnlockEvent(const std::string &vehiclename) const
{
    for (unsigned int i = 0; i < events.size(); i++) {
        for (UnlockData::const_iterator iter = events[i].unlocks.begin(); iter != events[i].unlocks.end(); ++iter) {
