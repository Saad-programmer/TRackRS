        glScalef(20.0f, 20.0f, 20.0f);
        glColor4f(gwc.marked.x, gwc.marked.y, gwc.marked.z, gwc.marked.w);
        getSSRender().drawText("Complete event " + unlockevent + " to unlock", PTEXT_HZA_CENTER | PTEXT_VTA_CENTER);
        glPopMatrix(); // 1
