    if (correction < -PI) { correction += PI*2.0f; if (correction < -PI) correction += PI*2.0f; }
    
    vehic->ctrl.turn.z = correction * 2.0f + randm11 * 0.2f;
    
    vehic->ctrl.throttle = 1.0f - fabsf(correction) * 0.8f;
