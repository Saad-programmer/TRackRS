#define CLAMP_UPPER(v,max) v = MIN(v, max)
#define CLAMP_LOWER(v,min) v = MAX(v, min)
#define CLAMP(v,min,max) v = MAX(MIN(v, max), min)
#define INTERP(a,b,f) ((a) + ((b) - (a)) * (f))

